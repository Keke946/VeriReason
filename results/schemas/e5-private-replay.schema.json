{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "E5 private replay journal; NEVER a public result file",
  "type": "object",
  "required": ["schema_version", "experiment_id", "session_id", "selection", "context", "phase", "records", "audit", "gate", "optimizer_steps", "pending", "started_at", "updates"],
  "properties": {
    "schema_version": {"const": 1},
    "experiment_id": {"const": "e5_capture_audit_smoke_001"},
    "session_id": {"type": "string", "minLength": 1},
    "phase": {"enum": ["preflight", "capturing", "captured", "awaiting_review", "gated", "updating", "finishing", "complete", "stopped"]},
    "context": {"type": "object", "required": ["parent"], "properties": {"parent": {"const": "e1_m4_formal_sft_001"}}},
    "selection": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/selection"}},
    "records": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/record"}},
    "audit": {"type": "array", "maxItems": 32, "items": {"type": "object", "required": ["row", "semantic", "mapped", "useful", "mask", "advantages", "semantic_reason", "token_reason"]}},
    "gate": {"type": ["object", "null"]},
    "optimizer_steps": {"type": "integer", "minimum": 0, "maximum": 8},
    "pending": {"oneOf": [{"type": "null"}, {"type": "object", "minProperties": 1, "maxProperties": 1, "additionalProperties": false, "properties": {"generation": {"type": "integer", "minimum": 0, "maximum": 7}, "update": {"type": "integer", "minimum": 0, "maximum": 7}}}]},
    "started_at": {"type": "number"},
    "updates": {"type": "array", "maxItems": 8},
    "numerics": {"type": "object"},
    "finish": {"type": "object"},
    "stop_reason": {"type": "string"}
  },
  "additionalProperties": false,
  "$defs": {
    "ids": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
    "selection": {
      "type": "object",
      "required": ["example_id", "prompt", "gold_sql", "database_path", "split", "operational_eligible"],
      "properties": {"example_id": {"type": "string", "minLength": 1}, "prompt": {"type": "string"}, "gold_sql": {"type": "string"}, "database_path": {"type": "string"}, "split": {"const": "train"}, "operational_eligible": {"const": true}}
    },
    "record": {
      "type": "object",
      "required": ["example_id", "group", "rollout", "prompt_ids", "text", "completion_ids", "completion_mask", "old_logps", "old_logps_dtype", "reward", "terminal_status", "truncated", "eos_id", "pad_id"],
      "properties": {
        "example_id": {"type": "string"}, "group": {"type": "integer", "minimum": 0, "maximum": 7},
        "rollout": {"type": "integer", "minimum": 0, "maximum": 3},
        "prompt_ids": {"$ref": "#/$defs/ids"}, "completion_ids": {"$ref": "#/$defs/ids"},
        "text": {"type": "string"}, "completion_mask": {"type": "array", "minItems": 1, "items": {"enum": [0, 1]}},
        "old_logps": {"type": "array", "minItems": 1, "items": {"type": "number", "maximum": 0}},
        "old_logps_dtype": {"enum": ["float32", "float64", "float16", "bfloat16"]},
        "reward": {"enum": [0, 1]}, "terminal_status": {"type": "string"},
        "truncated": {"type": "boolean"}, "eos_id": {"type": "integer", "minimum": 0},
        "pad_id": {"type": "integer", "minimum": 0}
      }, "additionalProperties": false
    }
  }
}
